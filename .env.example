# Supabase PostgreSQL connection string (session mode pooler, port 5432)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Polygon on-chain ingest (alchemy_getAssetTransfers): full URL including key
# ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Optional: Polymarket API key (only needed for authenticated endpoints, not required for data gathering)
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_PASSPHRASE=
